# Copy to deploy/deploy.env (git-ignored) and adjust.
DEPLOY_HOST=bazi-digital          # an SSH host alias from ~/.ssh/config
DEPLOY_DIR=/opt/shiftyar          # where the app lives on the server
DOMAIN=shift.bazidigital.ir       # public hostname served by nginx
APP_PORT=8090                     # loopback port nginx proxies to
KEEP_BACKUPS=14                   # database dumps to keep
# CERTBOT_EMAIL=you@example.com
# GOPROXY=https://goproxy.cn,direct            # if the server can't reach proxy.golang.org (e.g. hosted in Iran)
# IMAGE=ghcr.io/bazi-digital/shiftyar:latest   # pull a CI-built image instead of building on the server
